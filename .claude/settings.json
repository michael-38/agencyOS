{
  "permissions": {
    "allow": [
      "Bash(node scripts/prepare-client.mjs:*)",
      "Bash(node scripts/finish-client.mjs:*)",
      "Bash(node .impeccable/seed-client.mjs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive.sh" }
        ]
      }
    ]
  }
}
