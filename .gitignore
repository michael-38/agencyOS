# Secrets — drop ANTHROPIC_API_KEY into templates/med-spa/.env (see .env.example)
.env
.env.local
.env.*.local
*.log
.DS_Store
dist/
build/
.claude/*
!.claude/agentos/
!.claude/skills/
!.claude/hooks/
!.claude/agents/
